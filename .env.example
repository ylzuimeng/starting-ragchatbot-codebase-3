# Copy this file to .env and add your actual API keys

# Anthropic API Configuration (for Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: Custom base URL for Anthropic-compatible APIs (e.g., ZhipuAI proxy)
# Leave empty to use official Anthropic API
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# ZhipuAI API Configuration (for embeddings)
# Get your API key at: https://open.bigmodel.cn/
ZHIPUAI_API_KEY=your-zhipuai-api-key-here

# JWT Authentication Configuration
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-key-in-production

# Database Configuration
DATABASE_URL=sqlite:///./users.db